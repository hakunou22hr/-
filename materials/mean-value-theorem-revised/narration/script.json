{
  "language": "ja-JP",
  "voice": "ja-JP-KeitaNeural",
  "rate": "+0%",
  "duration": 90,
  "cues": [
    {
      "start": 3.0,
      "end": 9.5,
      "text": "さあ、先生と一緒に、傾きが出会う瞬間を探してみよう。"
    },
    {
      "start": 12.7,
      "end": 16.0,
      "text": "まず、横の変化を見てみよう。"
    },
    {
      "start": 20.1,
      "end": 23.0,
      "text": "おお、これが割線だね。"
    },
    {
      "start": 23.2,
      "end": 26.5,
      "text": "平均は、四割る二で、二なんだね。"
    },
    {
      "start": 27.7,
      "end": 31.0,
      "text": "今の接線は、平均より緩やかだね。"
    },
    {
      "start": 34.0,
      "end": 36.8,
      "text": "おお、傾きが二になった。"
    },
    {
      "start": 40.0,
      "end": 42.9,
      "text": "今度は三。変わるんだね。"
    },
    {
      "start": 47.1,
      "end": 50.4,
      "text": "おお、傾きが同じだね。"
    },
    {
      "start": 50.8,
      "end": 56.3,
      "text": "三角形が重なった。なるほど、二本は平行なんだ。"
    },
    {
      "start": 57.6,
      "end": 62.5,
      "text": "ここからが大事。図と計算がつながるね。"
    },
    {
      "start": 63.2,
      "end": 65.9,
      "text": "二シーが二、ということか。"
    },
    {
      "start": 66.2,
      "end": 69.5,
      "text": "シーは一。ここで一致するんだ。"
    },
    {
      "start": 69.6,
      "end": 75.1,
      "text": "途中に、こんな点が必ずある。それを保証する定理なんだね。"
    },
    {
      "start": 76.4,
      "end": 79.7,
      "text": "同じ傾きでも、別の直線なんだね。"
    },
    {
      "start": 80.5,
      "end": 83.8,
      "text": "この条件、忘れずにね。"
    },
    {
      "start": 85.1,
      "end": 89.5,
      "text": "なるほど。平均と瞬間がつながったね。"
    }
  ],
  "role": "授業者のアシスタント。図の変化への短い反応と確認を行い、教員の解説のための間を残す。"
}
