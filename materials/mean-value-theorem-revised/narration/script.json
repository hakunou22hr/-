{
  "language": "ja-JP",
  "voice": "ja-JP-KeitaNeural",
  "rate": "+0%",
  "duration": 90,
  "cues": [
    {
      "start": 0.8,
      "end": 11.4,
      "text": "黒板の放物線、ワイ イコール エックス二乗。エックスがゼロから二へ増えると、ワイはゼロから四へ増えます。"
    },
    {
      "start": 12.5,
      "end": 26.3,
      "text": "横の変化量は二。縦の変化量は四。平均の変化率は、四割る二で、二です。横に一進む間に、縦に平均して二増える、という意味です。"
    },
    {
      "start": 27.4,
      "end": 31.0,
      "text": "点ピーの接線。傾きは一です。"
    },
    {
      "start": 31.6,
      "end": 36.2,
      "text": "点を動かすと、接線の傾きは二になります。"
    },
    {
      "start": 37.1,
      "end": 42.5,
      "text": "さらに進むと三。場所によって、変化の速さが違います。"
    },
    {
      "start": 43.4,
      "end": 49.4,
      "text": "割線の傾きは二。点ピーを戻すと、接線の傾きも二になります。"
    },
    {
      "start": 50.0,
      "end": 56.5,
      "text": "横に一、縦に二。三角形を重ねると、二本が平行だと分かります。"
    },
    {
      "start": 57.2,
      "end": 62.6,
      "text": "全体の平均は二。途中の瞬間の変化率は、二かけるシー。"
    },
    {
      "start": 63.1,
      "end": 68.5,
      "text": "二かけるシーは二。シーは一。ここで一致します。"
    },
    {
      "start": 69.2,
      "end": 75.4,
      "text": "全体の平均と同じ瞬間の変化率が、途中にある。これが平均値の定理です。"
    },
    {
      "start": 76.0,
      "end": 79.6,
      "text": "同じ傾きなので、二本は平行です。"
    },
    {
      "start": 80.0,
      "end": 84.0,
      "text": "閉区間で連続、開区間で微分可能。"
    },
    {
      "start": 84.5,
      "end": 89.6,
      "text": "この条件で、一致する点が、途中に少なくとも一つ存在します。"
    }
  ]
}
